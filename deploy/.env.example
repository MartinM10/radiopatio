# ─────────────────────────────────────────────────────────────────────────────
# Entorno de producción — copiar a .env y rellenar.
# Generar secretos: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Dominio público apuntando al VPS (A record).
SITE_DOMAIN=api.tudominio.es
# Correo para el certificado Let's Encrypt de Caddy.
ACME_EMAIL=tu-correo@ejemplo.com

# PostgreSQL
POSTGRES_DB=radiopatio
POSTGRES_USER=radiopatio
POSTGRES_PASSWORD=cambia-esto-por-un-valor-largo-generado

# Seguridad de la app (obligatorios, mínimo 32 caracteres: openssl rand -hex 32).
# El servidor NO arranca en producción con valores por defecto o cortos.
# OJO: cambiar DEVICE_SALT invalida todos los tokens e identidades existentes.
DEVICE_SALT=
ADMIN_TOKEN=

# Identidad y anti-Sybil
# Altas de dispositivo anónimo por IP y hora.
REGISTER_RATE_MAX=10
# Client ID de OAuth de Google (Google Cloud Console). Vacío = login con Google desactivado.
GOOGLE_CLIENT_ID=
# 1 = solo cuentas verificadas (Google) pueden publicar, confirmar o denunciar.
# Activar en cuanto la app publicada incluya el inicio de sesión con Google.
REQUIRE_VERIFIED_IDENTITY=0
CORS_ORIGIN=*
RATE_LIMIT_MAX=600
PURGE_INTERVAL_MINUTES=15

# Juez secundario (Myrmo-style): score-only, nunca portero. Desactivado.
JUDGE_ENABLED=0
JUDGE_PROVIDER=
JUDGE_MODEL=

# Backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24

# Red del reverse proxy existente (p. ej. ops-proxy con Myrmo en el VPS)
EDGE_NETWORK=ops-proxy_default

# Puertos del host (solo necesarios si se levanta el Caddy standalone propio con --profile standalone)
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443
