# Caddyfile — TLS automático (Let's Encrypt) y cabeceras de seguridad.
# El dominio se inyecta desde .env (SITE_DOMAIN).
{$SITE_DOMAIN} {
    reverse_proxy server:3000
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(self)"
    }

    # No hay vistas web en la API: el resto da 404.
    respond / 404
}

# Si SITE_DOMAIN está vacío, Caddy arranca en modo local (sin TLS),
# útil para probar el compose en el propio VPS antes de apuntar DNS.
