{
  "expo": {
    "name": "Radio Patio",
    "slug": "radio-patio",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.radiopatio",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tu ubicación se usa solo para centrar el mapa y ayudarte a situar el aviso."
      }
    },
    "android": {
      "package": "app.radiopatio",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#021536",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6a895840-8ad3-4437-b41c-a96dc49d1023"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#021536",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#021536"
          }
        }
      ]
    ]
  }
}
