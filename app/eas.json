{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.radiopatio.app"
      },
      "description": "APK firmada para instalar directo (piloto interno): enlace descargable en expo.dev"
    },
    "production": {
      "android": {
        "buildType": "aab"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.radiopatio.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
