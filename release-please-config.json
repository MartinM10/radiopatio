{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "radiopatio",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": false,
      "include-v-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "app/app.json",
          "jsonpath": "$.expo.version"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "✨ Funcionalidades" },
        { "type": "fix", "section": "🐛 Correcciones" },
        { "type": "perf", "section": "⚡ Rendimiento" },
        { "type": "refactor", "section": "♻️ Refactorización" },
        { "type": "docs", "section": "📝 Documentación" },
        { "type": "build", "section": "📦 Compilación y EAS" },
        { "type": "ci", "section": "🚀 Integración Continua" },
        { "type": "chore", "section": "🔧 Mantenimiento", "hidden": false }
      ]
    }
  }
}
